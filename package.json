{
  "name": "@biqydu/elysia-email",
  "version": "1.1.0",
  "description": "Simple, typed email sending plugin for ElysiaJS supporting multiple providers.",
  "license": "MIT",
  "author": "Biqydu <brajanpalgan5@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Biqydu/elysia-mail.git"
  },
  "bugs": {
    "url": "https://github.com/Biqydu/elysia-mail/issues"
  },
  "homepage": "https://github.com/Biqydu/elysia-mail#readme",
  "keywords": [
    "elysia",
    "elysiajs",
    "plugin",
    "email",
    "mail",
    "resend",
    "mailgun",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun build.ts",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "elysia": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "elysia": "^1.4.30",
    "typescript": "^7"
  }
}
